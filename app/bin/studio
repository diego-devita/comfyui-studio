#!/usr/bin/env python3
"""ComfyUI Studio CLI — entry point.

This file lives in STUDIO_DIR/app/bin/studio and is added to PATH
by start.sh: export PATH="${STUDIO_DIR}/app/bin:$PATH"

All logic is in app/cli.py — this is just a launcher.
"""
import os
import sys
from pathlib import Path

# Resolve STUDIO_DIR and add to Python path
studio_dir = Path(os.environ.get("STUDIO_DIR", "/workspace/studio"))
sys.path.insert(0, str(studio_dir))

from app.cli import main
main()

{
  "manifest_version": 3,
  "name": "ComfyUI Studio",
  "version": "2.1.0",
  "description": "RunPod pod manager + CivitAI browser for ComfyUI Studio. Check models, download deps, create presets.",
  "permissions": ["storage", "tabs", "sidePanel", "activeTab"],
  "host_permissions": [
    "https://api.runpod.io/*",
    "https://*.proxy.runpod.net/*",
    "https://civitai.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

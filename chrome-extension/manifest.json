{
  "manifest_version": 3,
  "name": "ComfyUI Studio",
  "version": "1.1.0",
  "description": "Manage RunPod GPU pods and browse CivitAI models with ComfyUI Studio integration — check model status, download dependencies, and create presets from CivitAI images.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://api.runpod.io/*",
    "https://*.proxy.runpod.net/*",
    "https://civitai.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

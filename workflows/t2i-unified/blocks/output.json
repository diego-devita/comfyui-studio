{
  "nodes": {
    "save": {
      "inputs": {
        "filename_prefix": "comfyui-studio/{{output_dir}}/image",
        "images": "{{image}}"
      },
      "class_type": "SaveImage",
      "_meta": {"title": "Save Image (Batch {{batch_num}})"}
    }
  },
  "imports": ["image"],
  "exports": {},
  "variables": ["output_dir", "batch_num"]
}

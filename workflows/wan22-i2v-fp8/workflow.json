    "class_type": "RIFE VFI",
    "_meta": {"title": "RIFE 4x (16fps to 60fps)"}
  },
  "28": {
    "inputs": {
      "frame_rate": 60,
      "loop_count": 0,
      "filename_prefix": "comfyui-studio/video",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true,
      "images": ["27", 0]

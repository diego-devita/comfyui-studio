{
  "1": {
    "inputs": {
      "image": "input.png"
    },
    "class_type": "LoadImage",
    "_meta": {"title": "INPUT IMAGE"}
  },
  "2": {
    "inputs": {
      "text": "",
      "clip": ["18", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "POSITIVE PROMPT"}
  },
  "3": {
    "inputs": {
      "text": "Overexposure, static, blurred details, subtitles, paintings, pictures, still, overall gray, worst quality, low quality, JPEG compression residue, ugly, mutilated, redundant fingers, poorly painted hands, poorly painted faces, deformed, disfigured, deformed limbs, fused fingers, cluttered background, three legs, a lot of people in the background, upside down",
      "clip": ["18", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "NEGATIVE PROMPT"}
  },
  "4": {
    "inputs": {
      "value": 81
    },
    "class_type": "PrimitiveInt",
    "_meta": {"title": "DURATION FRAMES (81=5s 161=10s 241=15s 321=20s)"}
  },
  "5": {
    "inputs": {
      "Number": 1.5
    },
    "class_type": "Float",
    "_meta": {"title": "CFG (1.0-3.0)"}
  },
  "6": {
    "inputs": {
      "Number": 1.5
    },
    "class_type": "Float",
    "_meta": {"title": "UPSCALE FACTOR (1.0=none 1.5=720p 2.0=960p)"}
  },

  "7": {
    "inputs": {
      "image": ["1", 0]
    },
    "class_type": "GetImageSize+",
    "_meta": {"title": "Read Image Size"}
  },
  "8": {
    "inputs": {
      "value": "min(a, b)",
      "a": ["7", 0],
      "b": ["7", 1]
    },
    "class_type": "SimpleMath+",
    "_meta": {"title": "Min Dimension"}
  },
  "9": {
    "inputs": {
      "value": "480 / a",
      "a": ["8", 0]
    },
    "class_type": "SimpleMath+",
    "_meta": {"title": "Scale to 480p"}
  },
  "10": {
    "inputs": {
      "value": "round(a * b / 16) * 16",
      "a": ["7", 0],
      "b": ["9", 1]
    },
    "class_type": "SimpleMath+",
    "_meta": {"title": "Gen Width (snap 16px)"}
  },
  "11": {
    "inputs": {
      "value": "round(a * b / 16) * 16",
      "a": ["7", 1],
      "b": ["9", 1]
    },
    "class_type": "SimpleMath+",
    "_meta": {"title": "Gen Height (snap 16px)"}
  },

  "12": {
    "inputs": {
      "unet_name": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {"title": "UNET High Noise FP8"}
  },
  "13": {
    "inputs": {
      "unet_name": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",

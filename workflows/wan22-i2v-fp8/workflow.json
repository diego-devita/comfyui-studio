    },
    "class_type": "UNETLoader",
    "_meta": {"title": "UNET Low Noise FP8"}
  },
  "14": {
    "inputs": {
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors",
      "strength_model": 1.0,
      "model": ["12", 0]
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {"title": "LoRA 4-step High Noise"}
  },
  "15": {
    "inputs": {
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
      "strength_model": 1.0,
      "model": ["13", 0]
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {"title": "LoRA 4-step Low Noise"}
  },
  "16": {
    "inputs": {
      "shift": 8.0,
      "model": ["14", 0]
    },
    "class_type": "ModelSamplingSD3",
    "_meta": {"title": "Shift High Noise"}
  },
  "17": {
    "inputs": {
      "shift": 8.0,
      "model": ["15", 0]
    },
    "class_type": "ModelSamplingSD3",
    "_meta": {"title": "Shift Low Noise"}
  },
  "18": {
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {"title": "CLIP UMT5 FP8"}
  },
  "19": {
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {"title": "VAE WAN 2.1"}
  },

  "20": {
    "inputs": {
      "width": ["10", 0],
      "height": ["11", 0],
      "length": ["4", 0],
      "batch_size": 1,
      "positive": ["2", 0],
      "negative": ["3", 0],
      "vae": ["19", 0],
      "start_image": ["1", 0]
    },
    "class_type": "WanImageToVideo",
    "_meta": {"title": "WAN 2.2 Image to Video"}
  },
  "21": {
    "inputs": {
      "add_noise": "enable",
      "noise_seed": 42,
      "steps": 8,
      "cfg": ["5", 0],
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 0,
      "end_at_step": 4,
      "return_with_leftover_noise": "enable",
      "model": ["16", 0],
      "positive": ["20", 0],
      "negative": ["20", 1],
      "latent_image": ["20", 2]
    },
    "class_type": "KSamplerAdvanced",
    "_meta": {"title": "Pass 1 High Noise (steps 0-4)"}
  },
  "22": {
    "inputs": {
      "add_noise": "disable",
      "noise_seed": 0,
      "steps": 8,
      "cfg": ["5", 0],
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 4,
      "end_at_step": 8,
      "return_with_leftover_noise": "disable",
      "model": ["17", 0],
      "positive": ["20", 0],
      "negative": ["20", 1],
      "latent_image": ["21", 0]
    },
    "class_type": "KSamplerAdvanced",
    "_meta": {"title": "Pass 2 Low Noise (steps 4-8)"}
  },
  "23": {
    "inputs": {
      "samples": ["22", 0],
      "vae": ["19", 0]
    },
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"}
  },

  "24": {
    "inputs": {
      "value": "a * b",
      "a": ["10", 0],
      "b": ["6", 0]
    },
    "class_type": "SimpleMath+",
    "_meta": {"title": "Upscaled Width"}
  },
  "25": {
    "inputs": {
      "value": "a * b",
      "a": ["11", 0],
      "b": ["6", 0]
    },
    "class_type": "SimpleMath+",
    "_meta": {"title": "Upscaled Height"}
  },
  "26": {
    "inputs": {
      "upscale_method": "lanczos",
      "width": ["24", 0],
      "height": ["25", 0],
      "crop": "center",
      "image": ["23", 0]
    },
    "class_type": "ImageScale",
    "_meta": {"title": "Lanczos Upscale"}
  },
  "27": {
    "inputs": {
      "ckpt_name": "rife49.pth",
      "clear_cache_after_n_frames": 5,
      "multiplier": 4,
      "fast_mode": false,
      "ensemble": true,
      "scale_factor": 1,
      "dtype": "float32",
      "torch_compile": false,
      "batch_size": 1,
      "frames": ["26", 0]
